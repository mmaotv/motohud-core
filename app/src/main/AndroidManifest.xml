<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 蓝牙（车机 BLE 连接） -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 第三方导航桥接：常驻前台服务读取高德/百度广播并转发到车机 -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 检查更新与下载安装包 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 高德地图 / 搜索 / 定位 SDK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:name=".MotoHudApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MotoHeadUnit">

        <!-- 高德 API Key：构建时由 local.properties 注入，空值在应用内引导填写 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />

        <!-- 高德定位服务（地图蓝点依赖） -->
        <service
            android:name="com.amap.api.location.APSService"
            android:exported="false" />

        <!-- 高德搜索无独立 Service，CoreService 为旧版（4.x）遗留，此处不再声明 -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 首次启动新手引导 -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 连接车机（二级页）：原第 4 个页签降级而来 -->
        <activity
            android:name=".ui.scan.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 手机端专业导航页（地图 + 转向引导 + TTS 播报 + 画中画）
             screenOrientation=user：跟随系统自动旋转开关——开着就横竖屏跟随手机，
             关着保持竖屏。不写死 portrait：摩托车横置手机导航是常态场景。 -->
        <activity
            android:name=".ui.navi.GuidanceActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 二级页面容器（本地检索等低频功能） -->
        <activity
            android:name=".ui.HostActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 通知转发服务（复刻原 TWNotifyService：手机通知/来电 → 头盔） -->
        <service
            android:name=".service.NotificationForwardService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 导航前台服务：息屏导航时保持定位与 BLE 转发 -->
        <service
            android:name=".service.NaviForegroundService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:label="@string/navi_fg_channel" />

        <!--
          第三方导航桥接服务。

          Android 8.0 起隐式广播只有动态注册的接收器收得到，所以高德/百度的
          AUTONAVI_STANDARD_BROADCAST_SEND 必须靠一个常驻进程来接 —— 就是这个服务。

          用 specialUse 而不是 dataSync：Android 15 起 dataSync 前台服务
          24 小时内最多跑 6 小时，长途骑行会被系统掐掉。
        -->
        <service
            android:name=".service.NaviBridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/bridge_fg_channel">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="navigation_status_bridge" />
        </service>

        <!-- 路线选择页：先看方案再导航 -->
        <activity
            android:name=".ui.navi.RouteSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 关于页：版本、更新、车机信息 -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 导航历史：按时间范围查看过往导航记录 -->
        <activity
            android:name=".ui.navi.NaviHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 历史导航详情：行驶轨迹回放 + 再次导航 -->
        <activity
            android:name=".ui.navi.NaviHistoryDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 地图选点：给「起点 ≠ 当前位置」用 -->
        <activity
            android:name=".ui.navi.MapPickActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 地点搜索选点：起点 / 途经点共用，以当前位置为搜索中心 -->
        <activity
            android:name=".ui.navi.PlaceSearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit"
            android:windowSoftInputMode="adjustResize" />

        <!-- 避让区管理 / 圈选：用户自己标「这块不能进」 -->
        <activity
            android:name=".ui.navi.AvoidZoneActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />
        <activity
            android:name=".ui.navi.AvoidZoneEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit"
            android:windowSoftInputMode="adjustResize" />

        <!-- 离线语音引擎：模型下载 / 试听 / 删除 -->
        <activity
            android:name=".ui.navi.TtsModelActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 车况（二级页）：底部页签收成两个之后，从导航页「车况」按钮进入 -->
        <activity
            android:name=".ui.vehicle.VehicleActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 蓝牙连接诊断 -->
        <activity
            android:name=".ui.diagnostic.DiagnosticActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
