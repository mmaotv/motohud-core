<?xml version="1.0" encoding="utf-8"?>
<!--
  手机导航页（专业导航软件布局）

  层级：地图 → 顶部渐变 → 顶栏（返回/目的地/语音/投屏）→ 转向横幅 → 底部信息卡

  本次修复：
    1. 顶栏内所有按钮统一 44dp 圆形，目的地卡片改用圆角面板
       （原先误用 oval 的 bg_fab，宽屏下会被拉成椭圆，文字溢出）；
    2. 转向横幅放进顶栏的纵向容器里，随状态栏高度自适应，不再硬编码 marginTop；
    3. root 不再 fitsSystemWindows，改由代码按 WindowInsets 给顶栏加 padding，
       避免 44dp 固定值在刘海屏/手势导航上压到状态栏。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guidance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window">

    <!--
      路口放大图触发器（影子导航视图）

      **为什么必须有它**：路口/环岛/匝道/立交/大桥的放大图（`AMapNaviCross`）只在
      挂着 `AMapNaviView` 时才会由 SDK 生成并回调 `showCross()`。只拿裸 `AMapNavi`
      时 SDK 压根不向服务端请求这份图片数据，`showCross` 一次都不回调。
      `AMapNavi` 侧也没有任何替代入口（已 javap 全量核对）。

      真机验证（2026-10-31）：挂上它、且补调
      `AMapNaviCoreManager.setCrossImageSize(w,h)` 之后，机场路一趟连续回调了
      `showCross seq=1` / `seq=2`。两件事都做才有图，缺一不可。

      这里只作触发器：铺满全屏但 alpha=0.01（肉眼不可见）、放在**最底层**，
      触摸事件由上层的地图和按钮先接走；代码里另外关掉了它的 clickable/focusable。
      真正的图由我们自己画在 `ll_cross_panel` 里。
    -->
    <com.amap.api.navi.AMapNaviView
        android:id="@+id/shadow_navi_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.01"
        android:clickable="false"
        android:focusable="false" />

    <!-- 地图 -->
    <com.amap.api.maps.MapView
        android:id="@+id/guidance_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <!-- 顶部渐变（保证状态栏、顶栏在任意底图上可读）
         高度运行时按横竖屏调整：横屏屏矮，220dp 会盖掉大半张地图 -->
    <View
        android:id="@+id/top_scrim"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_navi_top" />

    <!-- 顶栏 + 转向横幅 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 目的地卡片。
                 返回键已提到根布局里独立悬浮（见文件末尾），
                 这里用 marginStart=52dp 给它留位，竖屏视觉与原来完全一致
                 （12dp 顶栏内边距 + 44dp 按钮 + 8dp 间距）。 -->
            <LinearLayout
                android:id="@+id/dest_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_navi_panel"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_dest_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="@string/hud_dest"
                        android:textColor="?attr/nvTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_mode_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_mode_badge"
                        android:fontFamily="@font/inter"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:text="@string/navi_mode_motorcycle"
                        android:textColor="?attr/nvAccent"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_dest_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!--
              语音 / 投屏两个按钮已从这一行移出，改成根布局里的悬浮容器
              @id/quick_actions（见文件末尾）：
                竖屏 —— 贴右上角，与原来位置视觉一致；
                横屏 —— 贴左上角返回键右边。
              横屏侧栏只有 300dp 宽、整屏才 360dp 高，这一行原来被两个 44dp 圆钮
              占掉整整 52dp，转向横幅就只能往下挤。挪走后顶栏第一行只剩目的地卡
              （横屏也是 GONE），整行塌陷，转向横幅直接顶到栏顶，横幅/车道行/电子眼行
              才够地方摆 —— 用户要的"右边露出更大空间"就是这 52dp。
            -->
            <!-- 画中画（Android 8+ 才显示，低版本隐藏） -->
            <ImageView
                android:id="@+id/btn_pip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_navi_circle"
                android:contentDescription="@string/navi_pip"
                android:padding="11dp"
                android:src="@drawable/ic_route"
                android:visibility="gone"
                app:tint="?attr/nvTextPrimary" />
        </LinearLayout>

        <!-- 转向横幅（放在顶栏内，自动跟随状态栏高度） -->
        <LinearLayout
            android:id="@+id/turn_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_navi_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!--
              转向图标放大到 88dp 并靠左：横屏侧栏只有 300dp 宽，原来 52dp 的图标
              在车机视角下（人眼到屏 40~60cm）几乎看不清是左转还是左前方。
              高德的导航卡也是"左边一个大箭头、右边一列文字"的结构。

              图用的是**高德官方**的 `amap_navi_lbs_sou*`（白色粗箭头 + 灰环），
              所以**不能加 tint**：加了会把灰环和箭头染成同一个颜色，环岛的
              「环 + 出口箭头」两层结构就糊成一个色块了。官方原图在深色面板上
              本来就是对的白字白图。
            -->
            <ImageView
                android:id="@+id/iv_turn_icon"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="?attr/nvTurnBadgeBg"
                android:contentDescription="@string/hud_turn_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/amap_navi_lbs_sou9" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 距离放在最上面、跟图标同一视觉重心，和高德一致：先说还有多远 -->
                <TextView
                    android:id="@+id/tv_turn_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/nvAccent"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="30sp"
                    app:autoSizeMinTextSize="18sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/tv_turn_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="2"
                    android:textColor="?attr/nvTextPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_turn_road"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextSecondary"
                    android:textSize="12sp" />

                <!-- 下一步预告（高德/百度都有，是"专业感"最直接的来源） -->
                <TextView
                    android:id="@+id/tv_turn_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 车道线指引（导航 SDK showLaneInfo）：几条车道 + 该走哪条 -->
        <!--
          车道线（导航 SDK showLaneInfo）：自绘箭头。SDK 给的是"每车道动作码 + 可用性"，
          不给箭头图；官方 AMapNaviView 内部渲染不对外，所以按同一套编码自绘。
        -->
        <com.motohud.ble.ui.navi.LaneGuideView
            android:id="@+id/ll_lane_guide"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_navi_panel"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <!--
          电子眼 / 限速（导航 SDK updateCameraInfo）：
          左边是限速徽章（红圈白底数字，和高德一样一眼可辨），右边是文字提示。
        -->
        <LinearLayout
            android:id="@+id/ll_camera_warn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_navi_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_limit_badge"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_limit_badge"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="?attr/nvDanger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_camera_warn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:textColor="?attr/nvWarn"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 路口放大图已移到地图层左下角，见布局顶部的 iv_cross_image -->

        <!--
          SDK 提示条：服务区 / 沿途交通事件（封路·施工）/ 可切主辅路。
          这三样都来自导航 SDK（onServiceAreaUpdate / onNaviRouteNotify / notifyParallelRoad），
          优先级一次只显示一条，避免路口前同时冒三行字盖住地图。
        -->
        <TextView
            android:id="@+id/tv_navi_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_navi_panel"
            android:fontFamily="@font/inter"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="?attr/nvAccent"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 信号弱提示 -->
        <TextView
            android:id="@+id/tv_signal_warn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_navi_panel"
            android:fontFamily="@font/inter"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/navi_signal_weak"
            android:textColor="?attr/nvWarn"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 更优/更畅通路线提示（非阻塞，横竖屏都贴在顶栏下方居中） -->
        <LinearLayout
            android:id="@+id/better_route_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_navi_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_better_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/nvTextPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_better_adopt"
                style="@style/Widget.Moto.Button.Accent"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:text="@string/guidance_better_route_adopt" />

            <Button
                android:id="@+id/btn_better_dismiss"
                style="@style/Widget.Moto.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:text="@string/guidance_better_route_dismiss" />
        </LinearLayout>
    </LinearLayout>

    <!--
      返回键：独立悬浮在左上角。
      原先它在顶栏第一行里，横屏把侧栏整体挪到右侧后，它会被一起带走 ——
      横屏左上角必须始终留一个返回键（也是唯一的「退出导航」入口，
      底部的「停止导航」按钮横屏已隐藏，两者功能重复）。
      位置由代码按 WindowInsets 给 topMargin/marginStart 赋值，与顶栏内边距对齐。
    -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_navi_circle"
        android:contentDescription="@string/cancel"
        android:padding="11dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="?attr/nvTextPrimary" />

    <!--
      语音 / 投屏：独立悬浮容器，不再挂在顶栏第一行里。

      位置由 applyOrientationLayout() 按方向切换：
        竖屏 gravity = top|end，marginEnd 12dp —— 与原来右上角位置一致，零回归；
        横屏 gravity = top|start，marginStart 64dp —— 紧贴左上角返回键右边（12+44+8）。

      为什么要挪：横屏右侧侧栏只有 300dp 宽、整屏 360dp 高，这两个 44dp 圆钮
      占掉顶栏第一行整整 52dp，转向横幅 + 车道行 + 电子眼行只能一路往下挤
      （真机上曾出现车道行与电子眼行重叠）。挪到左边后侧栏第一行塌陷，
      转向横幅直接顶到栏顶，52dp 全给横幅 —— 用户要的"右边露出更大空间"就是它。
      左上角本来就只承担"退出"，再加两个低频开关不会误触到导航内容。
    -->
    <LinearLayout
        android:id="@+id/quick_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_voice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_navi_circle"
            android:contentDescription="@string/navi_voice"
            android:padding="11dp"
            android:src="@drawable/ic_volume_on"
            app:tint="?attr/nvTextPrimary" />

        <ImageView
            android:id="@+id/btn_cast"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_navi_circle"
            android:contentDescription="@string/navi_cast"
            android:padding="11dp"
            android:src="@drawable/ic_cast"
            app:tint="?attr/nvAccent" />
    </LinearLayout>

    <!-- 浮动：全览 / 回中 -->
    <LinearLayout
        android:id="@+id/map_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="212dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btn_overview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_navi_circle"
            android:contentDescription="@string/navi_overview"
            android:padding="11dp"
            android:src="@drawable/ic_route"
            app:tint="?attr/nvTextPrimary" />

        <ImageView
            android:id="@+id/btn_recenter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_navi_circle"
            android:contentDescription="@string/navi_recenter"
            android:padding="11dp"
            android:src="@drawable/ic_my_location"
            app:tint="?attr/nvAccent" />
    </LinearLayout>

    <!-- 底部信息卡 -->
    <LinearLayout
        android:id="@+id/bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <!-- 折叠手柄：点一下展开/收起详细统计 -->
        <LinearLayout
            android:id="@+id/btn_expand"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_grabber" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_eta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guidance_eta"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_remain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guidance_remain"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_speed_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/nvAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guidance_speed"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_gps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_gps_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/tv_gps_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guidance_gps"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 展开后的详细统计（默认收起：骑行时只需要 ETA / 剩余 / 速度） -->
        <LinearLayout
            android:id="@+id/bottom_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/nvDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_lights"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="?attr/nvTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/guidance_lights"
                        android:textColor="?attr/nvTextTertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tolls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="?attr/nvTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/guidance_tolls"
                        android:textColor="?attr/nvTextTertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="?attr/nvTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/guidance_step_progress"
                        android:textColor="?attr/nvTextTertiary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 剩余路况（估算：搜索 SDK 没有实时路况分段，这里按每步 距离/时长 估算并注明） -->
            <TextView
                android:id="@+id/tv_traffic_estimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:textColor="?attr/nvTextSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_guidance_ble_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter"
            android:text="@string/guidance_ble_hint"
            android:textColor="?attr/nvTextTertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!--
          底部按钮行：竖屏是「停止导航 + 投屏到车机」两个并排大按钮。
          横屏整行隐藏 —— 停止导航与左上角返回键同一个动作（都走 confirmExit），
          投屏开关顶栏已有；横屏屏高只有 360dp，这 60dp 留给地图更值。
        -->
        <LinearLayout
            android:id="@+id/bottom_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_stop_navi"
                style="@style/Widget.Moto.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/guidance_stop" />

            <Button
                android:id="@+id/btn_cast_navi"
                style="@style/Widget.Moto.Button.Accent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/navi_cast_to_car" />
        </LinearLayout>
    </LinearLayout>

    <!-- 规划中遮罩 -->
    <LinearLayout
        android:id="@+id/planning_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="?attr/nvAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter"
            android:text="@string/guidance_planning"
            android:textColor="?attr/nvTextPrimary"
            android:textSize="14sp" />
    </LinearLayout>

    <!--
      到达终点卡片。
      原先只有一个"已到达"遮罩 + 完成按钮，等于把用户踢出去；
      现在给出这趟的实际结果（里程 / 用时 / 均速），并直接提供"看轨迹"和"再走一次"。
    -->
    <LinearLayout
        android:id="@+id/arrived_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/hud_arrived"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:text="@string/hud_arrived"
                android:textColor="?attr/nvTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_arrive_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/nvTextSecondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_arrive_distance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="?attr/nvTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/guidance_arrive_distance"
                        android:textColor="?attr/nvTextTertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_arrive_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="?attr/nvTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/guidance_arrive_duration"
                        android:textColor="?attr/nvTextTertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_arrive_avg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="?attr/nvAccent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/guidance_arrive_avg"
                        android:textColor="?attr/nvTextTertiary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_view_track"
                style="@style/Widget.Moto.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/guidance_view_track" />

            <Button
                android:id="@+id/btn_navi_again"
                style="@style/Widget.Moto.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/guidance_navi_again" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_finish_navi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:text="@string/guidance_finish"
            android:textColor="?attr/nvTextSecondary"
            android:textSize="14sp" />
    </LinearLayout>
    <!--
      路口放大图（导航 SDK showCross / showModeCross）：SDK 直接给位图。

      不是"一个黑底放张图"，而是一张完整的卡：**标题行（箭头 + 距离 + 动作）
      + 大图 + 底部 ETA 行**。理由：
       · 只给图时，骑手不知道"这张图是几米后的那个路口"，也不知道还剩多远到目的地；
       · 侧栏的转向卡/车道/电子眼在这两三秒里确实重复，但"预计到达 + 剩余里程"
         **不重复、且一直在被看**，所以保留在卡片底部（用户明确要求）。
      大图撤掉后整栏原样恢复（见 GuidanceActivity.setCrossMode）。

      环岛 / 匝道 / 立交 / 大桥 走的是同两个回调，SDK 认为需要放大时就会推对应的图。
    -->
    <LinearLayout
        android:id="@+id/ll_cross_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_cross_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- 标题行：和转向卡同一套视觉语言（大箭头 + 大距离 + 动作） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 大图卡头部的小转向图标：同样是官方 sou* 图，不加 tint（原因见转向卡） -->
            <ImageView
                android:id="@+id/iv_cross_turn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/nvTurnBadgeBg"
                android:contentDescription="@string/hud_turn_icon"
                android:src="@drawable/amap_navi_lbs_sou9" />

            <TextView
                android:id="@+id/tv_cross_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textColor="?attr/nvAccent"
                android:textSize="26sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="26sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/tv_cross_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:textColor="?attr/nvTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="?attr/nvDivider" />

        <!-- 大图：占满中间剩余空间，fitCenter 不裁切路形 -->
        <ImageView
            android:id="@+id/iv_cross_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/hud_turn_icon"
            android:scaleType="fitCenter" />

        <!-- 底部：预计到达 / 剩余距离（用户要求保留），空间够时再加当前速度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cross_eta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/nvAccent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guidance_eta"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cross_remain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guidance_remain"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cross_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/nvTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guidance_speed"
                    android:textColor="?attr/nvTextTertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
