<?xml version="1.0" encoding="utf-8"?>
<!-- 路线偏好：智能推荐（单选） + 六个可多选的约束 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_prefs_smart_desc"
            android:textColor="?attr/mtTextTertiary"
            android:textSize="12sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_smart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/route_pref_smart"
            android:textColor="@color/checkbox_text"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:background="?attr/mtCardStroke" />

        <TextView
            android:id="@+id/tv_multi_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_prefs_multi_desc"
            android:textColor="?attr/mtTextTertiary"
            android:textSize="12sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_highway_first"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/route_pref_highway_first"
            android:textColor="@color/checkbox_text"
            android:textSize="15sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_avoid_highway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/route_pref_avoid_highway"
            android:textColor="@color/checkbox_text"
            android:textSize="15sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_avoid_jam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/route_pref_avoid_jam"
            android:textColor="@color/checkbox_text"
            android:textSize="15sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_avoid_toll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/route_pref_avoid_toll"
            android:textColor="@color/checkbox_text"
            android:textSize="15sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_traffic_first"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/route_pref_traffic_first"
            android:textColor="@color/checkbox_text"
            android:textSize="15sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_time_first"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/route_pref_time_first"
            android:textColor="@color/checkbox_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/route_prefs_motor_note"
            android:textColor="?attr/mtTextTertiary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
