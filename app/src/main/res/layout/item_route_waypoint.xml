<?xml version="1.0" encoding="utf-8"?>
<!-- 途经点行：序号 + 名称 + 删除。点行改点、长按排序，见 RouteSelectActivity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wp_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/wp_index"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:fontFamily="@font/inter"
        android:textColor="@color/accent"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/route_waypoint"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/wp_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wp_remove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/route_waypoint_remove"
        android:padding="9dp"
        android:src="@drawable/ic_close"
        android:tint="@color/text_tertiary" />
</LinearLayout>
