<?xml version="1.0" encoding="utf-8"?>
<!-- 引导页 4：导航教学 + 高德 Key 配置说明 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mtWindow"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        style="@style/TextAppearance.Moto.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/onboarding_navi_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 步骤 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="1"
                android:textColor="?attr/mtTextOnAccent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="@string/onboarding_navi_step1_body"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 步骤 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="2"
                android:textColor="?attr/mtTextOnAccent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="@string/onboarding_navi_step2_body"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 步骤 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="3"
                android:textColor="?attr/mtTextOnAccent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="@string/onboarding_navi_step3_body"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Key 配置说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/amap_key_title"
                android:src="@drawable/ic_key" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/onboarding_navi_key_hint"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
