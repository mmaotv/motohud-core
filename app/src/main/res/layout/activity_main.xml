<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 连接状态条：未连接时引导去连接，连接后显示设备名 -->
    <LinearLayout
        android:id="@+id/banner_connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/banner_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@string/status_disconnected"
            android:src="@drawable/dot_gray" />

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:text="@string/status_disconnected"
            android:textColor="?attr/mtTextPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/banner_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:padding="8dp"
            android:text="@string/empty_action"
            android:textColor="?attr/mtAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--
          日 / 夜开关。

          为什么放这儿：主题原来只在设置面板里（要滚两屏才看得到），骑手在路边
          戴着手套根本点不到。这条状态条在「爱车 / 导航」两个 tab 上都常驻，
          40dp 触摸区，单手可及。

          图标显示的是「点一下会变成什么」—— 当前是白天就显示月亮。
          单击切换白天/夜间，长按恢复自动（按当地日出日落），见 MainActivity。
        -->
        <FrameLayout
            android:id="@+id/btn_theme"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/theme_toggle_to_night"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_theme"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_theme_night"
                app:tint="?attr/mtTextSecondary" />
        </FrameLayout>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/banner_connection"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.motohud.ble.ui.SixItemBottomNavView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mtBarSurface"
        app:elevation="0dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>
