<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.Moto.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/command_title" />

            <TextView
                android:id="@+id/tv_device_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/command_device_unknown"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="13sp" />

            <TextView
                style="@style/TextAppearance.Moto.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/command_navi_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/command_icon"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinner_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter"
                android:text="@string/command_path_remain"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek_path_remain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="?attr/mtAccent"
                android:thumbTint="?attr/mtAccent" />

            <TextView
                android:id="@+id/tv_path_remain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="500 m"
                android:textColor="?attr/mtTextPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter"
                android:text="@string/command_step_remain"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek_step_remain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="20"
                android:progressTint="?attr/mtAccent"
                android:thumbTint="?attr/mtAccent" />

            <TextView
                android:id="@+id/tv_step_remain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="200 m"
                android:textColor="?attr/mtTextPrimary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_hello"
                    style="@style/Widget.Moto.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/command_hello"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_navi"
                    style="@style/Widget.Moto.Button.Accent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/command_navi"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_finish"
                    style="@style/Widget.Moto.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/command_finish"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Moto.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/command_custom_title" />

            <EditText
                android:id="@+id/et_custom_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:fontFamily="@font/inter"
                android:hint="@string/command_custom_hint"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="?attr/mtTextPrimary"
                android:textColorHint="?attr/mtTextTertiary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_send_custom"
                    style="@style/Widget.Moto.Button.Accent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/command_send"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_msg_test"
                    style="@style/Widget.Moto.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/command_msg_test"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/empty_state"
        layout="@layout/layout_empty_state" />
</FrameLayout>
