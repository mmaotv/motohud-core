<?xml version="1.0" encoding="utf-8"?>
<!--
  路线选择页 = 一张完整的地图 + 两层浮层。

  改造前是「上面一长串表单（起点 / 途经点 / 添加途经点 / 沿途搜索 / 目的地 /
  偏好 / 避让区）+ 中间一个 220dp 的小地图 + 下面的方案列表」，要看方案得先
  滚两屏，地图小得看不出绕不绕路。

  现在地图铺满整屏，所有信息压成两层浮层：
  · 顶部：返回 + 起点→终点→途经点（一眼看清"从哪到哪、途经哪"）
  · 底部：方案卡片（横向滑）+ 开始导航

  「添加途经点」和「沿途搜索」合并成底部那一个 `rs_add_waypoint` 入口 ——
  两者本来就都是"往路线里塞一个点"，分两个按钮只会让人犹豫点哪个。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mtWindow">

    <!-- 地图容器：没 Key / 没同意隐私时整块隐藏，露出底色当兜底 -->
    <FrameLayout
        android:id="@+id/rs_map_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.amap.api.maps.MapView
            android:id="@+id/rs_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 顶部：返回 + 起终点卡 -->
    <LinearLayout
        android:id="@+id/rs_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/rs_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_navi_circle"
            android:contentDescription="@string/cancel"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/mtTextPrimary" />

        <LinearLayout
            android:id="@+id/rs_endpoints_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_navi_panel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <!-- 起点（可改） -->
            <LinearLayout
                android:id="@+id/rs_origin_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="26dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_green" />

                <TextView
                    android:id="@+id/rs_origin_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/origin_current"
                    android:textColor="?attr/mtTextPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/origin_change"
                    android:textColor="?attr/mtAccent"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/mtDivider" />

            <!-- 终点（不再展示经纬度，普通用户无需看到坐标） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_orange" />

                <TextView
                    android:id="@+id/rs_dest_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:textColor="?attr/mtTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 途经点：移到顶部起终点卡片内，点 + 加号即可追加必经点（不再占底部面板一整行） -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/rs_waypoint_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <!--
                      合并入口：单击 = 搜索 / 沿途搜（同一个搜索页，分类与自由输入都在里面），
                      长按 = 直接在地图上点位置。
                    -->
                    <LinearLayout
                        android:id="@+id/rs_add_waypoint"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="11dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/route_waypoint_add_merged"
                            android:src="@drawable/ic_add"
                            app:tint="?attr/mtAccent" />

                        <TextView
                            android:id="@+id/rs_add_waypoint_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/route_waypoint_add_merged"
                            android:textColor="?attr/mtAccent"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/rs_waypoint_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/inter"
                            android:textColor="?attr/mtTextTertiary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- 地图上的操作提示（多方案时提示"点卡片切换"），位置由代码贴在顶部卡下方 -->
    <TextView
        android:id="@+id/rs_map_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_navi_panel"
        android:elevation="3dp"
        android:fontFamily="@font/inter"
        android:paddingStart="9dp"
        android:paddingTop="5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="5dp"
        android:text="@string/route_select_map_hint"
        android:textColor="?attr/mtTextSecondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!--
      底部面板：途经点 + 方案 + 开始导航。
      面板贴底，上面留出地图 —— 方案换一条，地图立刻跟着高亮，不用再滚回去看。
    -->
    <LinearLayout
        android:id="@+id/rs_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_navi_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- 方案卡片：横向滑，横向排才看得出"谁快谁慢" -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rs_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/rs_loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:indeterminateTint="?attr/mtAccent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rs_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="@string/route_select_empty"
            android:textColor="?attr/mtTextTertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 工具行：偏好 / 避让区 / 第三方地图，都收成小胶囊，不占纵向空间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/rs_pref_row"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="?attr/mtAccent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/rs_avoid_row"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/rs_other_map"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/route_select_other_map"
                android:textColor="?attr/mtTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/rs_start"
            style="@style/Widget.Moto.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:text="@string/route_select_start"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
