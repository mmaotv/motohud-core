<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏导航条（RemoteViews）。

  骑行时手机常放兜里或屏幕熄灭，这里是最高频的"瞥一眼"入口 ——
  也是删掉横屏 HUD 页之后它的真正替代品。

  RemoteViews 只支持有限的 View 类型，所以这里只用 LinearLayout / ImageView / TextView，
  不能用 ConstraintLayout、不能用自定义字体属性。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/notif_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/hud_turn_icon"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_turn_straight" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/navi_fg_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/navi_fg_text"
            android:textColor="#99EBEBF5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
