<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.Moto.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exam_title" />

        <TextView
            android:id="@+id/switch_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/exam_no_data"
            android:textColor="?attr/mtTextSecondary"
            android:textSize="13sp" />

        <TextView
            style="@style/TextAppearance.Moto.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/exam_fault_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fault_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:layoutAnimation="@anim/layout_animation_fall_down" />

        <TextView
            android:id="@+id/fault_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/exam_no_fault"
            android:textColor="?attr/mtTextTertiary"
            android:textSize="13sp" />
    </LinearLayout>

    <include
        android:id="@+id/empty_state"
        layout="@layout/layout_empty_state" />
</FrameLayout>
