<?xml version="1.0" encoding="utf-8"?>
<!--
  候选路线卡片（横向排布，一张卡一条方案）。

  重排为两行，比原来四行矮，底部面板能收得更紧：
  · 第 1 行：推荐角标（左上）+ 大号时间（同行右侧）
  · 第 2 行：公里数 + 红绿灯 / 过路费细节（同行）
  信息层级不变：**多久**最大（选哪条就看这个），距离次之，细节最轻。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="188dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:minHeight="62dp"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="9dp"
    android:paddingEnd="13dp"
    android:paddingBottom="9dp">

    <!-- 第 1 行：推荐角标（左上）+ 大号时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_route_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mode_badge"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="?attr/mtAccent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_route_eta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="?attr/mtTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第 2 行：公里数 + 红绿灯 / 过路费细节（同行） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_route_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="?attr/mtTextSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_route_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="?attr/mtTextTertiary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
