<?xml version="1.0" encoding="utf-8"?>
<!--
  候选路线卡片（横向排布，一张卡一条方案）。

  改造前是整行铺满（时间在左、细节在右），因为列表是竖着排的。
  现在方案列表改成地图底部的横向滑动条，卡片必须自带固定宽度，
  否则一张卡就占满一屏、还看不出有第二条。

  信息层级不变：**多久**最大（选哪条就看这个），距离次之，细节最轻。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="188dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:minHeight="86dp"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="10dp"
    android:paddingEnd="13dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tv_route_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mode_badge"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:textColor="?attr/mtAccent"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_route_eta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/inter"
        android:maxLines="1"
        android:textColor="?attr/mtTextPrimary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_route_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/inter"
        android:maxLines="1"
        android:textColor="?attr/mtTextSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_route_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:maxLines="1"
        android:textColor="?attr/mtTextTertiary"
        android:textSize="11sp" />
</LinearLayout>
