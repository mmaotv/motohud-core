<?xml version="1.0" encoding="utf-8"?>
<!-- 爱车页：上半屏车型大图 + 关键数据 + 功能宫格 + 车辆参数 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="28dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <!-- ================= Hero：车型大图 ================= -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="252dp"
            android:background="@drawable/bg_hero_frame"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/iv_bike"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/garage_bike_photo"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_garage" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_hero" />

            <View
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_hero_bottom" />

            <!-- 连接状态胶囊 -->
            <LinearLayout
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_status_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/dot_gray" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!--
              搜索 / 设置原本是页面底部两个大方块（"功能"板块），
              在半屏都是图片的首页上显得又大又空。收成 Hero 右上角两个圆形图标，
              功能一个不少，纵向长度直接省掉 100dp 左右。
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_search"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_navi_circle"
                    android:contentDescription="@string/nav_search"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_search" />

                <ImageView
                    android:id="@+id/iv_settings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_navi_circle"
                    android:contentDescription="@string/settings_title"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <!-- 品牌 / 车型 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="112dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="0.18"
                    android:text="@string/garage_brand_placeholder"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/garage_model_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 换车 -->
            <TextView
                android:id="@+id/btn_change_bike"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_status_pill"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/garage_change"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- ================= 车机连接卡 =================
             连接页从底部页签降级后，这里是它的主入口。
             一个用户只有一台车机，所以卡片只记一台，并提供「更换车机」。
        -->
        <LinearLayout
            android:id="@+id/card_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/card_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_gray" />

                <TextView
                    android:id="@+id/card_device_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/device_card_not_connected"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/card_device_action"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_pill"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/device_card_connect"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/card_device_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter"
                android:text="@string/device_card_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!--
              「打开 App 自动连接」开关移到设置页。
              首页把开关、连接、更换车机三件事挤在一张卡上，用户分不清主次；
              连接卡只留「连/断/换」，策略类开关统一去设置。
            -->
            <TextView
                android:id="@+id/card_change_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/device_card_change"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= 关键数据 =================
             车机侧实测拿不到遥测（上行帧恒为 0），这三格在真机上常年是空值。
             因此整块默认隐藏，只有真的收到数据才显示：
             首页不该用一排空框占掉一整屏。
             水温单独去掉：它既拿不到，也不是骑行时最关心的量。 -->
        <LinearLayout
            android:id="@+id/metric_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_metric"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_oil"
                    style="@style/Garage.Metric.Value"
                    android:text="@string/garage_value_empty" />

                <TextView
                    style="@style/Garage.Metric.Label"
                    android:text="@string/garage_metric_oil" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_battery"
                    style="@style/Garage.Metric.Value"
                    android:text="@string/garage_value_empty" />

                <TextView
                    style="@style/Garage.Metric.Label"
                    android:text="@string/garage_metric_battery" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_mileage"
                    style="@style/Garage.Metric.Value"
                    android:text="@string/garage_value_empty" />

                <TextView
                    style="@style/Garage.Metric.Label"
                    android:text="@string/garage_metric_mileage" />
            </LinearLayout>
        </LinearLayout>

        <!--
          原「未连接提示条 + 去连接」在这里删除。
          连接入口全应用只保留一处：底部「连接」页（外加顶部状态条的引导）。
          同一屏出现两个「去连接」，用户不知道该点哪个。
        -->

        <!-- ================= 车辆参数 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/garage_section_specs"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/garage_specs_note"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 亮点标签 -->
            <LinearLayout
                android:id="@+id/highlight_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/spec_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/garage_disclaimer"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
