    <!-- 兼容旧引用 -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FFFF9F0A</color>
    <color name="purple_700">#FFCC7A08</color>
    <color name="teal_200">#FF30D158</color>
    <color name="teal_700">#FF1E9E42</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="ic_launcher_background">#FF1D1D1F</color>

    <!--
      ==================== 全局页面配色（其它界面用） ====================

      上面那批 `pal_night_*` / `pal_day_*` 原本是导航页专属，现在提升为**全 App
      调色板**：所有页面的配色属性（`mt*`，见 attrs.xml）都指向这里。

      这里补的是「非导航页」才用得到的角色：窗口底色、实心表面、填充块、
      输入框描边、弹窗、底部导航选中态、轨迹线。命名沿用白天/夜间两套，
      值全部与导航页同一套体系（强调色、文字三级、危险色完全共用）。
    -->

    <!-- 夜间（= 现状） -->
    <color name="pal_night_window">#FF000000</color>
    <color name="pal_night_surface">#FF1C1C1E</color>
    <color name="pal_night_surface_high">#F21C1C1E</color>
    <color name="pal_night_fill">#2E787880</color>
    <color name="pal_night_fill_strong">#52787880</color>
    <color name="pal_night_hairline">#1AFFFFFF</color>
    <color name="pal_night_accent_dim">#4DFF9F0A</color>
    <color name="pal_night_text_on_accent">#FF1D1D1F</color>
    <color name="pal_night_green">#FF30D158</color>
    <color name="pal_night_green_dim">#4D30D158</color>
    <color name="pal_night_red_dim">#4DFF453A</color>
    <color name="pal_night_dialog_surface">#FF1F1F22</color>
    <color name="pal_night_dialog_stroke">#33FFFFFF</color>
    <color name="pal_night_bar_surface">#FF1C1C1E</color>
    <color name="pal_night_track_done">#FF8A8A8E</color>
    <color name="pal_night_track_ahead">#FFFF9F0A</color>
    <color name="pal_night_nav_checked">#FFFF9F0A</color>
    <color name="pal_night_nav_unchecked">#99EBEBF5</color>
    <!-- 输入框 / 搜索栏底色：比卡片再深一档，才有"凹槽"感 -->
    <color name="pal_night_field">#F22C2C2E</color>
    <!-- 车库页 hero 展示区渐变（摩托车整车图背后那块） -->
    <color name="pal_night_hero_from">#FF2A2A2E</color>
    <color name="pal_night_hero_to">#FF08080A</color>

    <!--
      白天。

      window 刻意用**浅灰 #F2F3F5** 而不是纯白：卡片本身是白的，页面底也是白
      就分不出层次了（iOS 系统设置页就是灰底白卡）。纯白只留给卡片、弹窗、
      顶栏这些"浮起来"的表面。
    -->
    <color name="pal_day_window">#FFF2F3F5</color>
    <color name="pal_day_surface">#FFFFFFFF</color>
    <color name="pal_day_surface_high">#FFFFFFFF</color>
    <color name="pal_day_fill">#14000000</color>
    <color name="pal_day_fill_strong">#29000000</color>
    <color name="pal_day_hairline">#1F000000</color>
    <color name="pal_day_accent_dim">#1AE07000</color>
    <color name="pal_day_text_on_accent">#FFFFFFFF</color>
    <color name="pal_day_green">#FF1B8F3A</color>
    <color name="pal_day_green_dim">#1A1B8F3A</color>
    <color name="pal_day_red_dim">#1AD70015</color>
    <color name="pal_day_dialog_surface">#FFFFFFFF</color>
    <color name="pal_day_dialog_stroke">#29000000</color>
    <color name="pal_day_bar_surface">#FFFFFFFF</color>
    <color name="pal_day_track_done">#FF8A8A8E</color>
    <color name="pal_day_track_ahead">#FFE07000</color>
    <color name="pal_day_nav_checked">#FFE07000</color>
    <color name="pal_day_nav_unchecked">#99000000</color>
    <color name="pal_day_field">#FFFFFFFF</color>
    <color name="pal_day_hero_from">#FFFFFFFF</color>
    <color name="pal_day_hero_to">#FFE9EBEF</color>

    <!-- HUD 投屏导航配色（深色底，高对比） -->
    <color name="hud_background">#FF000000</color>
    <color name="hud_text_primary">#FFFFFFFF</color>
    <color name="hud_text_secondary">#FF9AA7B8</color>
    <color name="hud_accent">#FFFF9F0A</color>

    <!-- 底部导航选中态 -->
    <color name="nav_item_checked">#FFFF9F0A</color>
    <color name="nav_item_unchecked">#99EBEBF5</color>
</resources>
