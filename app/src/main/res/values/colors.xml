<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 设计语言（参考 aerial-tv：tvOS 暗色玻璃风） -->
    <color name="bg_window">#FF000000</color>
    <color name="surface">#FF1C1C1E</color>
    <color name="surface_high">#F21C1C1E</color>
    <color name="card_glass">#E6202022</color>
    <color name="card_stroke">#1AFFFFFF</color>
    <color name="fill">#2E787880</color>
    <color name="fill_strong">#52787880</color>
    <color name="hairline">#1AFFFFFF</color>

    <!-- 分隔线（卡片内部分区；比 hairline 略明显一点） -->
    <color name="divider">#1FFFFFFF</color>

    <!-- 导航轨迹：已走路段（灰）与未走路段（主色） -->
    <color name="track_done">#8A8A8E</color>
    <color name="track_ahead">#FFFF9F0A</color>

    <!-- 弹窗专用表面色：必须完全不透明。
         surface_high(#F21C1C1E) 带 alpha，是为叠加在纯黑窗口上的玻璃卡片设计的，
         拿去做弹窗填充会透出背后的地图/列表，看起来像"弹窗是半透明的 bug"。 -->
    <color name="dialog_surface">#FF1F1F22</color>
    <color name="dialog_stroke">#33FFFFFF</color>

    <!-- 顶栏/底栏专用表面色：必须完全不透明，保证顶部状态条与底部导航栏颜色一致 -->
    <color name="bar_surface">#FF1C1C1E</color>

    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#99EBEBF5</color>
    <color name="text_tertiary">#4DEBEBF5</color>

    <!-- 语义色 -->
    <color name="accent">#FFFF9F0A</color>
    <color name="accent_dim">#4DFF9F0A</color>
    <color name="green">#FF30D158</color>
    <color name="green_dim">#4D30D158</color>
    <color name="red">#FFFF453A</color>
    <color name="red_dim">#4DFF453A</color>
    <color name="orange">#FFFF9F0A</color>

    <color name="text_on_accent">#FF1D1D1F</color>

    <!-- 兼容旧引用 -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FFFF9F0A</color>
    <color name="purple_700">#FFCC7A08</color>
    <color name="teal_200">#FF30D158</color>
    <color name="teal_700">#FF1E9E42</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="ic_launcher_background">#FF1D1D1F</color>

    <!-- HUD 投屏导航配色（深色底，高对比） -->
    <color name="hud_background">#FF000000</color>
    <color name="hud_text_primary">#FFFFFFFF</color>
    <color name="hud_text_secondary">#FF9AA7B8</color>
    <color name="hud_accent">#FFFF9F0A</color>

    <!-- 底部导航选中态 -->
    <color name="nav_item_checked">#FFFF9F0A</color>
    <color name="nav_item_unchecked">#99EBEBF5</color>
</resources>
