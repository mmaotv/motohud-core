    <color name="pal_day_lane_bg_active">#FF1466CC</color>
    <color name="pal_day_lane_arrow">#FFFFFFFF</color>
    <color name="pal_day_lane_arrow_dim">#99FFFFFF</color>

    <!-- 压在深色照片上的文字：不跟主题，永远浅色（照片是深色素材） -->
    <color name="on_photo_primary">#FFFFFFFF</color>
    <color name="on_photo_secondary">#B3EBEBF5</color>

    <!-- 交通标志蓝：转向图标底衬 / 车道牌同源 -->
