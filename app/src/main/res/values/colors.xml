<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 设计语言（参考 aerial-tv：tvOS 暗色玻璃风） -->
    <color name="bg_window">#FF000000</color>
    <color name="surface">#FF1C1C1E</color>
    <color name="surface_high">#F21C1C1E</color>
    <color name="card_glass">#E6202022</color>
    <color name="card_stroke">#1AFFFFFF</color>
    <color name="fill">#2E787880</color>
    <color name="fill_strong">#52787880</color>
    <color name="hairline">#1AFFFFFF</color>

    <!-- 分隔线（卡片内部分区；比 hairline 略明显一点） -->
    <color name="divider">#1FFFFFFF</color>

    <!-- 导航轨迹：已走路段（灰）与未走路段（主色） -->
    <color name="track_done">#8A8A8E</color>
    <color name="track_ahead">#FFFF9F0A</color>

    <!-- 弹窗专用表面色：必须完全不透明。
         surface_high(#F21C1C1E) 带 alpha，是为叠加在纯黑窗口上的玻璃卡片设计的，
         拿去做弹窗填充会透出背后的地图/列表，看起来像"弹窗是半透明的 bug"。 -->
    <color name="dialog_surface">#FF1F1F22</color>
    <color name="dialog_stroke">#33FFFFFF</color>

    <!-- 顶栏/底栏专用表面色：必须完全不透明，保证顶部状态条与底部导航栏颜色一致 -->
    <color name="bar_surface">#FF1C1C1E</color>

    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#99EBEBF5</color>
    <color name="text_tertiary">#4DEBEBF5</color>

    <!-- 语义色 -->
    <color name="accent">#FFFF9F0A</color>
    <color name="accent_dim">#4DFF9F0A</color>
    <color name="green">#FF30D158</color>
    <color name="green_dim">#4D30D158</color>
    <color name="red">#FFFF453A</color>
    <color name="red_dim">#4DFF453A</color>
    <color name="orange">#FFFF9F0A</color>
    <!-- 电子眼色标第三档（占道类拍照）：黄，比橙弱、比灰显眼 -->
    <color name="yellow">#FFFFD60A</color>

    <color name="text_on_accent">#FF1D1D1F</color>

    <!--
      ==================== 导航页 日 / 夜 双套配色 ====================

      这些色值只经 attrs 的 nv* 属性被引用，不直接在布局里写死 ——
      切换主题时改的是主题里的映射，布局一个字都不用动。

      夜晚那套就是原来的深色玻璃风，一个色值都没改（零回归）。
      白天那套的思路不是"把黑换成白"那么简单：
        · 面板用 **97% 白**而不是纯白 —— 纯白在地图（本身就是浅灰）上会失去
          "浮起来"的层次，97% 白配 8% 黑描边才有卡片的边界感；
        · 橙色 accent 在纯白上对比度只有 2.4:1，30sp 大字勉强、12sp 小字就废了，
          所以白天把橙**压深**到 #E07000（对比度约 3.4:1），仍是同一个色相；
        · 警示橙同理压到 #D95300，红色用 #D70015（比夜间的 #FF453A 深一档）。
      夜间：面板近黑半透明，白天：面板近白半透明。
    -->

    <!-- 夜间（= 现状，全局基础主题用这套） -->
    <color name="pal_night_text_primary">#FFFFFFFF</color>
    <color name="pal_night_text_secondary">#99EBEBF5</color>
    <color name="pal_night_text_tertiary">#4DEBEBF5</color>
    <color name="pal_night_accent">#FFFF9F0A</color>
    <color name="pal_night_warn">#FFFF9F0A</color>
    <color name="pal_night_danger">#FFFF453A</color>
    <color name="pal_night_caution">#FFFFD60A</color>
    <color name="pal_night_divider">#1FFFFFFF</color>
    <color name="pal_night_panel">#F0141416</color>
    <color name="pal_night_panel_stroke">#33FFFFFF</color>
    <color name="pal_night_circle">#E6141416</color>
    <color name="pal_night_circle_stroke">#40FFFFFF</color>
    <color name="pal_night_cross_panel">#FF0B0B0D</color>
    <color name="pal_night_bottom_card">#F21C1C1E</color>
    <color name="pal_night_card">#E6202022</color>
    <color name="pal_night_card_stroke">#1AFFFFFF</color>
    <color name="pal_night_badge">#33FF9F0A</color>
    <color name="pal_night_badge_stroke">#66FF9F0A</color>
    <color name="pal_night_grabber">#40FFFFFF</color>
    <color name="pal_night_scrim_from">#CC000000</color>
    <color name="pal_night_scrim_to">#00000000</color>
    <color name="pal_night_shade">#B3000000</color>
    <color name="pal_night_lane_bg">#1AFFFFFF</color>
    <color name="pal_night_lane_bg_active">#33FFFFFF</color>
    <color name="pal_night_lane_arrow">#FFFFFFFF</color>
    <color name="pal_night_lane_arrow_dim">#59FFFFFF</color>

    <!-- 白天 -->
    <color name="pal_day_text_primary">#FF16181C</color>
    <color name="pal_day_text_secondary">#99000000</color>
    <color name="pal_day_text_tertiary">#4D000000</color>
    <color name="pal_day_accent">#FFE07000</color>
    <color name="pal_day_warn">#FFD95300</color>
    <color name="pal_day_danger">#FFD70015</color>
    <color name="pal_day_caution">#FF9E6B00</color>
    <color name="pal_day_divider">#1F000000</color>
    <color name="pal_day_panel">#F7FFFFFF</color>
    <color name="pal_day_panel_stroke">#14000000</color>
    <color name="pal_day_circle">#FFFFFFFF</color>
    <color name="pal_day_circle_stroke">#29000000</color>
    <color name="pal_day_cross_panel">#FFFFFFFF</color>
    <color name="pal_day_bottom_card">#F7FFFFFF</color>
    <color name="pal_day_card">#F7FFFFFF</color>
    <color name="pal_day_card_stroke">#1A000000</color>
    <color name="pal_day_badge">#1AE07000</color>
    <color name="pal_day_badge_stroke">#40E07000</color>
    <color name="pal_day_grabber">#33000000</color>
    <color name="pal_day_scrim_from">#FFF2F3F5</color>
    <color name="pal_day_scrim_to">#00FFFFFF</color>
    <color name="pal_day_shade">#B3FFFFFF</color>
