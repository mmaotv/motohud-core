<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：tvOS 暗色玻璃风（参考 aerial-tv 设计语言） -->
    <style name="Theme.MotoHeadUnit" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:colorBackground">@color/bg_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_window</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="colorError">@color/red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHighlight">@color/accent_dim</item>
        <!-- 全局弹窗统一外观（圆角 + 描边），所有 MaterialAlertDialogBuilder 自动继承。
             注意：这里只能设 materialAlertDialogTheme（它是 ThemeOverlay 类型）；
             alertDialogTheme 要求完整 Dialog 主题，指过去会在 inflate
             m3_alert_dialog 时因缺少布局属性直接崩。 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Moto.Dialog</item>
        <item name="android:colorBackgroundFloating">@color/surface_high</item>
        <!-- 转场动画 -->
        <item name="android:windowAnimationStyle">@style/Animation.MotoActivity</item>

        <!--
          ==================== 导航页配色（夜间 = 现状） ====================
          基础主题里全部落成夜间值，所以任何没套白天主题的页面行为完全不变。
          逐项说明见 values/attrs.xml。
        -->
        <item name="nvTextPrimary">@color/pal_night_text_primary</item>
        <item name="nvTextSecondary">@color/pal_night_text_secondary</item>
        <item name="nvTextTertiary">@color/pal_night_text_tertiary</item>
        <item name="nvAccent">@color/pal_night_accent</item>
        <item name="nvWarn">@color/pal_night_warn</item>
        <item name="nvDanger">@color/pal_night_danger</item>
        <item name="nvCaution">@color/pal_night_caution</item>
        <item name="nvDivider">@color/pal_night_divider</item>
        <item name="nvPanelColor">@color/pal_night_panel</item>
        <item name="nvPanelStroke">@color/pal_night_panel_stroke</item>
        <item name="nvCircleColor">@color/pal_night_circle</item>
        <item name="nvCircleStroke">@color/pal_night_circle_stroke</item>
        <item name="nvCrossPanelColor">@color/pal_night_cross_panel</item>
        <item name="nvBottomCardColor">@color/pal_night_bottom_card</item>
        <item name="nvCardColor">@color/pal_night_card</item>
        <item name="nvCardStroke">@color/pal_night_card_stroke</item>
        <item name="nvBadgeColor">@color/pal_night_badge</item>
        <item name="nvBadgeStroke">@color/pal_night_badge_stroke</item>
        <item name="nvGrabberColor">@color/pal_night_grabber</item>
