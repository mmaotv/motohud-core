        <item name="nvShadeColor">@color/pal_night_shade</item>
        <!-- 夜间不加底衬：官方 sou 图是白箭头，深色面板上本来就对。
             用透明 drawable 而不是 @null —— 见 bg_turn_badge_none.xml 里的说明 -->
        <item name="nvTurnBadgeBg">@drawable/bg_turn_badge_none</item>
        <item name="nvLaneBg">@color/pal_night_lane_bg</item>
        <item name="nvLaneBgActive">@color/pal_night_lane_bg_active</item>
        <item name="nvLaneArrow">@color/pal_night_lane_arrow</item>
        <item name="nvLaneArrowDim">@color/pal_night_lane_arrow_dim</item>

        <!--
          ==================== 全 App 通用配色（夜间 = 现状） ====================

          这批 `mt*` 是给「非导航页」用的（设置、车况、历史、搜索……）。
          值全部等于改造前写死的那些颜色，所以基础主题下视觉零变化。
        -->
        <item name="mtWindow">@color/pal_night_window</item>
        <item name="mtSurface">@color/pal_night_surface</item>
        <item name="mtSurfaceHigh">@color/pal_night_surface_high</item>
        <item name="mtBarSurface">@color/pal_night_bar_surface</item>
        <item name="mtCard">@color/pal_night_card</item>
        <item name="mtCardStroke">@color/pal_night_card_stroke</item>
        <item name="mtFill">@color/pal_night_fill</item>
        <item name="mtFillStrong">@color/pal_night_fill_strong</item>
        <item name="mtHairline">@color/pal_night_hairline</item>
        <item name="mtTextPrimary">@color/pal_night_text_primary</item>
        <item name="mtTextSecondary">@color/pal_night_text_secondary</item>
        <item name="mtTextTertiary">@color/pal_night_text_tertiary</item>
        <item name="mtDivider">@color/pal_night_divider</item>
        <item name="mtAccent">@color/pal_night_accent</item>
        <item name="mtAccentDim">@color/pal_night_accent_dim</item>
        <item name="mtTextOnAccent">@color/pal_night_text_on_accent</item>
        <item name="mtGreen">@color/pal_night_green</item>
        <item name="mtGreenDim">@color/pal_night_green_dim</item>
        <item name="mtRed">@color/pal_night_danger</item>
        <item name="mtRedDim">@color/pal_night_red_dim</item>
        <item name="mtOrange">@color/pal_night_warn</item>
        <item name="mtYellow">@color/pal_night_caution</item>
        <item name="mtField">@color/pal_night_field</item>
        <item name="mtHeroFrom">@color/pal_night_hero_from</item>
        <item name="mtHeroTo">@color/pal_night_hero_to</item>
        <item name="mtDialogSurface">@color/pal_night_dialog_surface</item>
        <item name="mtDialogStroke">@color/pal_night_dialog_stroke</item>
        <item name="mtTrackDone">@color/pal_night_track_done</item>
        <item name="mtTrackAhead">@color/pal_night_track_ahead</item>
        <item name="mtNavChecked">@color/pal_night_nav_checked</item>
        <item name="mtNavUnchecked">@color/pal_night_nav_unchecked</item>
    </style>

    <!--
      ==================== 白天主题（全 App 通用） ====================

      **parent 是 Material3.Light，不是继承 Theme.MotoHeadUnit。**
      父类若仍是 `Material3.Dark`，Switch / CheckBox / Slider / Chip 这些
      Material 组件会用"深色变体"的默认色（轨道、滑块、禁用态前景），
      在浅色卡片上看起来像是坏的；要想靠覆盖修正，得把
      colorSurfaceContainerLowest..Highest、colorOutlineVariant 等十来个
      内部 token 全部重写一遍，且随 Material 版本还会变。直接换 Light 父类，
      组件自己就对了，我们只负责把品牌色和自定义属性补上。

      用法：在 `setContentView` **之前**
        `setTheme(R.style.Theme_MotoHeadUnit_Day)`

      见 `ui/theme/AppTheme.kt` —— 全 App 的页面入口统一调它。
    -->
    <style name="Theme.MotoHeadUnit.Day" parent="Theme.Material3.Light.NoActionBar">
        <!-- ====== 窗口 ====== -->
        <item name="android:windowBackground">@color/pal_day_window</item>
        <item name="android:colorBackground">@color/pal_day_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/pal_day_bar_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:windowAnimationStyle">@style/Animation.MotoActivity</item>

        <!-- ====== Material 语义色 ====== -->
        <item name="colorPrimary">@color/pal_day_accent</item>
        <item name="colorOnPrimary">@color/pal_day_text_on_accent</item>
        <item name="colorSecondary">@color/pal_day_accent</item>
        <item name="colorOnSecondary">@color/pal_day_text_on_accent</item>
        <item name="colorSurface">@color/pal_day_surface</item>
        <item name="colorOnSurface">@color/pal_day_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/pal_day_text_secondary</item>
        <item name="colorOutline">@color/pal_day_card_stroke</item>
        <item name="colorError">@color/pal_day_danger</item>
        <item name="android:textColorPrimary">@color/pal_day_text_primary</item>
        <item name="android:textColorSecondary">@color/pal_day_text_secondary</item>
        <item name="android:textColorHint">@color/pal_day_text_tertiary</item>
        <item name="android:editTextColor">@color/pal_day_text_primary</item>
        <item name="android:textColorHighlight">@color/pal_day_accent_dim</item>
        <item name="android:colorBackgroundFloating">@color/pal_day_surface</item>
        <!--
          弹窗 overlay 与夜间**共用同一个**，不另建 .Day 版本：
          overlay 里的颜色全部是 `?attr/mtXxx` 引用，求值时从当前主题取，
          白天自然拿到白底黑字。少一份需要同步维护的重复配置。
        -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Moto.Dialog</item>

        <!-- ====== 导航页 nv* ====== -->
        <item name="nvTextPrimary">@color/pal_day_text_primary</item>
        <item name="nvTextSecondary">@color/pal_day_text_secondary</item>
        <item name="nvTextTertiary">@color/pal_day_text_tertiary</item>
        <item name="nvAccent">@color/pal_day_accent</item>
        <item name="nvWarn">@color/pal_day_warn</item>
        <item name="nvDanger">@color/pal_day_danger</item>
        <item name="nvCaution">@color/pal_day_caution</item>
        <item name="nvDivider">@color/pal_day_divider</item>
        <item name="nvPanelColor">@color/pal_day_panel</item>
        <item name="nvPanelStroke">@color/pal_day_panel_stroke</item>
        <item name="nvCircleColor">@color/pal_day_circle</item>
        <item name="nvCircleStroke">@color/pal_day_circle_stroke</item>
        <item name="nvCrossPanelColor">@color/pal_day_cross_panel</item>
        <item name="nvBottomCardColor">@color/pal_day_bottom_card</item>
        <item name="nvCardColor">@color/pal_day_card</item>
        <item name="nvCardStroke">@color/pal_day_card_stroke</item>
        <item name="nvBadgeColor">@color/pal_day_badge</item>
        <item name="nvBadgeStroke">@color/pal_day_badge_stroke</item>
        <item name="nvGrabberColor">@color/pal_day_grabber</item>
        <item name="nvScrimFrom">@color/pal_day_scrim_from</item>
        <item name="nvScrimTo">@color/pal_day_scrim_to</item>
        <item name="nvShadeColor">@color/pal_day_shade</item>
        <!-- 白天必须给白箭头垫蓝底，否则官方白箭头在白面板上直接消失 -->
        <item name="nvTurnBadgeBg">@drawable/bg_turn_badge</item>
        <item name="nvLaneBg">@color/pal_day_lane_bg</item>
        <item name="nvLaneBgActive">@color/pal_day_lane_bg_active</item>
        <item name="nvLaneArrow">@color/pal_day_lane_arrow</item>
        <item name="nvLaneArrowDim">@color/pal_day_lane_arrow_dim</item>

        <!-- ====== 全局页面 mt* ====== -->
        <item name="mtWindow">@color/pal_day_window</item>
        <item name="mtSurface">@color/pal_day_surface</item>
        <item name="mtSurfaceHigh">@color/pal_day_surface_high</item>
        <item name="mtBarSurface">@color/pal_day_bar_surface</item>
        <item name="mtCard">@color/pal_day_card</item>
        <item name="mtCardStroke">@color/pal_day_card_stroke</item>
        <item name="mtFill">@color/pal_day_fill</item>
        <item name="mtFillStrong">@color/pal_day_fill_strong</item>
        <item name="mtHairline">@color/pal_day_hairline</item>
        <item name="mtTextPrimary">@color/pal_day_text_primary</item>
        <item name="mtTextSecondary">@color/pal_day_text_secondary</item>
        <item name="mtTextTertiary">@color/pal_day_text_tertiary</item>
        <item name="mtDivider">@color/pal_day_divider</item>
        <item name="mtAccent">@color/pal_day_accent</item>
        <item name="mtAccentDim">@color/pal_day_accent_dim</item>
        <item name="mtTextOnAccent">@color/pal_day_text_on_accent</item>
        <item name="mtGreen">@color/pal_day_green</item>
        <item name="mtGreenDim">@color/pal_day_green_dim</item>
        <item name="mtRed">@color/pal_day_danger</item>
        <item name="mtRedDim">@color/pal_day_red_dim</item>
        <item name="mtOrange">@color/pal_day_warn</item>
        <item name="mtYellow">@color/pal_day_caution</item>
        <item name="mtField">@color/pal_day_field</item>
        <item name="mtHeroFrom">@color/pal_day_hero_from</item>
        <item name="mtHeroTo">@color/pal_day_hero_to</item>
        <item name="mtDialogSurface">@color/pal_day_dialog_surface</item>
        <item name="mtDialogStroke">@color/pal_day_dialog_stroke</item>
        <item name="mtTrackDone">@color/pal_day_track_done</item>
        <item name="mtTrackAhead">@color/pal_day_track_ahead</item>
        <item name="mtNavChecked">@color/pal_day_nav_checked</item>
        <item name="mtNavUnchecked">@color/pal_day_nav_unchecked</item>
    </style>

    <!--
      旧名字，保留兼容。
      0.0.27 时这个白天主题只服务导航页（叫 NaviDay）；现在提升为全 App 通用
      的 `Theme.MotoHeadUnit.Day`。留一个空壳别名，避免旧入口引用报错。
    -->
    <style name="Theme.MotoHeadUnit.NaviDay" parent="Theme.MotoHeadUnit.Day" />

    <!-- ===================== 弹窗 ===================== -->

    <!--
      统一弹窗外观。
      Material3 的 AlertDialog 背景是一个 MaterialShapeDrawable，圆角与描边走
      shapeAppearanceOverlay + colorOutline，比塞一个 android:background 可靠
      （后者会被 builder 内部重设，导致"有的弹窗有边框、有的没有"）。
    -->
    <style name="ThemeOverlay.Moto.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!--
          这里必须是完全不透明的 dialog_surface。
          原先是 surface_high(#F21C1C1E)，那是配纯黑窗口的玻璃卡片色，
          一旦弹窗浮在地图/图片上，背景就会透出来（设置弹窗能看见摩托车）。
          主题层统一兜底，任何没走 MotoDialog.builder 的弹窗也不会再透。
        -->
        <item name="colorSurface">?attr/mtDialogSurface</item>
        <item name="colorOnSurface">?attr/mtTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/mtTextSecondary</item>
        <item name="colorOutline">?attr/mtCardStroke</item>
        <item name="colorPrimary">?attr/mtAccent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Moto.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Moto.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Moto.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Moto.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Moto.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Moto.Dialog.Button</item>
    </style>

    <style name="ShapeAppearance.Moto.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <!--
      坑：m3_alert_dialog_title.xml 里的标题 View 是这样写的——
        <androidx.appcompat.widget.DialogTitle android:id="@+id/alertTitle"
            style="?attr/materialAlertDialogTitleTextStyle"/>
      它自身没有任何 android:layout_width/height，宽高完全由这个样式提供。
      所以 parent 必须是 MaterialAlertDialog.*.Title.Text 系列（它的祖先
      Base.MaterialAlertDialog.MaterialComponents.Title.Text 里写了
      layout_width=match_parent / layout_height=wrap_content）。
      如果 parent 换成纯 TextAppearance.*，layout 属性就丢了，
      父 LinearLayout 建 LayoutParams 时直接抛
      UnsupportedOperationException: You must supply a layout_width attribute，
      表现为「点管理地址必闪退」。
      这里显式再写一次宽高，双保险，避免以后换 parent 又踩回去。
    -->
    <style name="TextAppearance.Moto.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Moto.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Moto.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">?attr/mtAccent</item>
    </style>

    <!-- Activity 转场（干脆的入场滑屏） -->
    <style name="Animation.MotoActivity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- 对话框动画 -->
    <style name="Theme.MotoDialog" parent="Theme.MotoHeadUnit">
        <item name="android:windowAnimationStyle">@style/Animation.MotoDialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">82%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <!--
      自定义 Dialog（`Dialog(ctx, R.style.Theme_MotoDialog)`）的白天版本。

      为什么要单独一份：Dialog 的主题是**独立**的，不会继承所在 Activity 的
      主题，所以白天页面上弹出来的 Dialog 里，`?attr/mtTextPrimary` 仍然会解析成
      夜间值（白字压在深色板上）。不能在代码里"顺手 setTheme 一下 Activity 的
      主题"——Dialog 需要 windowIsFloating / windowAnimationStyle 这些窗口属性，
      Activity 主题没有。

      选哪一份见 `AppTheme.dialogTheme()`。
    -->
    <style name="Theme.MotoDialog.Day" parent="Theme.MotoHeadUnit.Day">
        <item name="android:windowAnimationStyle">@style/Animation.MotoDialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">82%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimAmount">0.25</item>
    </style>

    <style name="Animation.MotoDialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <!-- 文本样式 -->
    <style name="TextAppearance.Moto.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Moto.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Moto.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Moto.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Moto.Callout" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Moto.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/mtTextTertiary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 组件样式 -->

    <!-- 玻璃卡片 -->
    <style name="Widget.Moto.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 主按钮（橙色） -->
    <style name="Widget.Moto.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_accent</item>
        <item name="android:textColor">?attr/mtTextOnAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">?attr/mtAccentDim</item>
        <item name="backgroundTint">@null</item>
        <!--
          这里原本有一条 android:layout_marginTop=8dp。
          样式里的 layout_* 会被解析成按钮自身的外边距，导致同一行里
          「投屏到车机」比「停止导航」低 8dp —— 就是那个"没有水平对齐"。
          布局属性一律写在 layout 里，样式只描述外观。
        -->
    </style>

    <!-- 幽灵按钮（描边） -->
    <style name="Widget.Moto.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="strokeColor">?attr/mtFillStrong</item>
    </style>

    <!-- 危险按钮 -->
    <style name="Widget.Moto.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- 输入框（搜索栏） -->
    <style name="Widget.Moto.SearchBar" parent="">
        <item name="android:background">@drawable/bg_search_bar</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- 区块标题 -->
    <style name="Widget.Moto.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- 保留旧样式引用（仪表卡片，逐步迁移） -->
    <style name="TelemetryCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <style name="TelemetryLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/mtTextSecondary</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TelemetryValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">?attr/mtTextPrimary</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
</resources>
