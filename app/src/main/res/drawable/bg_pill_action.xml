<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片里的动作胶囊（连接卡上的「重连 / 连接」按钮）。

  不要复用 bg_status_pill：那个是**压在摩托车照片上**的固定黑色胶囊
  （#8C000000），摆在白色卡片上会变成一块灰疙瘩、配深橙文字很脏。
  这里跟主题走：夜里是 30% 橙、白天是更淡的橙，文字始终用强调色。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/mtAccentDim" />
    <corners android:radius="15dp" />
</shape>
