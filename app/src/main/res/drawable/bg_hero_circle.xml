<?xml version="1.0" encoding="utf-8"?>
<!--
  车库页 hero 右上角两个圆钮（搜索 / 设置）。

  它压在摩托车照片上，但**跟着日 / 夜主题走**：
  夜间是半透深底 + 白图标，白天是白底 + 深图标。
  照片本身始终是深色素材，白圆钮在深色照片上足够醒目；
  反过来若固定深底，白天整个按钮会变成一块"黑疙瘩"，与浅色界面割裂。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/mtSurfaceHigh" />
    <stroke
        android:width="1dp"
        android:color="?attr/mtCardStroke" />
</shape>
