<?xml version="1.0" encoding="utf-8"?>
<!--
  日 / 夜开关用的两个图标（太阳 / 弯月）。

  颜色不写死在这里：由布局里的 `app:tint="?attr/mtTextSecondary"` 染色。
  单色 vector 才敢这么干 —— 双色图（比如高德那套 lbs_sou*）染完会糊成一块。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 日轮 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,6.2A5.8,5.8 0 1,1 11.99,6.2Z" />

    <!-- 8 条光芒：先画十字，再整体转 45° 复用一次 -->
    <group android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11,0.6h2v3.2h-2z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11,20.2h2v3.2h-2z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M0.6,11h3.2v2h-3.2z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M20.2,11h3.2v2h-3.2z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="45">
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11,0.6h2v3.2h-2z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11,20.2h2v3.2h-2z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M0.6,11h3.2v2h-3.2z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M20.2,11h3.2v2h-3.2z" />
    </group>
</vector>
