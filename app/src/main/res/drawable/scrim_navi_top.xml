<?xml version="1.0" encoding="utf-8"?>
<!--
  顶部渐变：让状态栏与目的地卡在地图 / 卫星图上始终可读。

  高度**不再写死**：`GuidanceActivity.updateScrimHeight()` 每次布局后按
  「状态栏 + 目的地卡下沿 + 10dp」实测设置，横竖屏、侧栏在左在右都是同一套规则。
  所以这里的比例只需要保证「实色区够用、尾巴够短」。

  前 76% 实色（centerY=0.76），后面 24% 快速渐隐到透明。
  原来 centerY=0.6 是配合 170dp 的：实色区 102dp、渐隐段 68dp。
  现在整体高度降到约 100dp（竖屏）/ 30~40dp（横屏），
  0.76 让实色区仍然完整压住状态栏和目的地卡，尾巴只有二十来 dp，
  地图上方不会再糊一层灰 —— 这就是用户反复说的"雾遮罩太厚"。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="?attr/nvScrimFrom"
        android:centerY="0.76"
        android:endColor="?attr/nvScrimTo"
        android:startColor="?attr/nvScrimFrom" />
</shape>
