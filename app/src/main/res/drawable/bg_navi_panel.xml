<?xml version="1.0" encoding="utf-8"?>
<!--
  导航页玻璃面板：圆角矩形（替换原先误用 oval 的 bg_fab）。

  色值走主题属性：夜间近黑玻璃、白天近白玻璃，由所在页面的 theme 决定。
  见 values/attrs.xml。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/nvPanelColor" />
    <stroke
        android:width="1dp"
        android:color="?attr/nvPanelStroke" />
    <corners android:radius="18dp" />
</shape>
