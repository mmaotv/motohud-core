<?xml version="1.0" encoding="utf-8"?>
<!--
  导航「当前位置」图标：蓝底圆 + 白色方向箭头（经典定位样式）。

  为什么不做成摩托车/车辆剪影：图标只有 32dp，俯视剪影在这个尺寸上
  只剩几根粗线，看起来像火柴人（真机截图确认过），反而认不出是车。
  方向感改由「箭头随行进方向旋转」承担 —— 一眼就知道车头朝哪，
  这也是高德/百度导航位置图标的通行做法。

  配色：蓝底 + 白环 + 白箭头。白天浅色地图上蓝块醒目；
  夜间深色地图上白环和白箭头发亮，不会糊进暗色路面。

  朝向：调用方用 billboard 标记并叠加「行进方位 - 地图方位」的旋转，
  所以不会被地图 3D 倾斜压扁。见 amap/VehicleMarker + GuidanceActivity.updateMeMarker。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- 白色描边环（先画大圆，再由蓝圆盖住中间，形成 2.5 宽的环） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,32 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0 Z" />

    <path
        android:fillColor="#FF2C7BE5"
        android:pathData="M7,32 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0 Z" />

    <!-- 方向箭头：尖端朝上（= 地图上方的行进方向），尾部内凹做出导航箭头感 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,13 L48,50 L32,42.5 L16,50 Z" />
</vector>
